      ],
      "segment": "millennial"
    },
    {
      "text": "Delivery timelines are too long, and orders are often not delivered on the promised date. Although Myntra and Flipkart belong to the same group, Flipkart provides much faster and more reliable delivery.",
      "source": "Play Store",
      "source_id": "361b7c5c-042b-4722-ae26-19eb87e7b124",
